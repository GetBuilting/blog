# mini_mall - 微型个人博客
# 环境变量配置

# Flask 密钥（生产环境请使用随机字符串）
SECRET_KEY=change-me-to-a-random-string

# 数据库连接（默认 SQLite）
DATABASE_URL=sqlite:///mini_mall.db

# GitHub 配置（用于 utteranc.es 评论 + Issue 管理）
# 格式: username/repo
GITHUB_REPO=your-username/your-repo
# GitHub Personal Access Token (需要有 repo scope)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# 站点基础 URL（用于生成 Issue 中的回链）
BASE_URL=http://localhost:5000

# Flask 环境
FLASK_ENV=development
